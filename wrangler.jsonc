{
  "name": "trishuldivine",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },
  // Per-visitor request limits for the checkout endpoints (see src/server/payments.js).
  "ratelimits": [
    { "name": "QUOTE_LIMITER", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } },
    { "name": "ORDER_LIMITER", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } }
  ],
  // Non-secret settings. Secrets (never put these here) are set with `wrangler secret put`:
  //   SUPABASE_SERVICE_ROLE_KEY, RAZORPAY_KEY_ID, RAZORPAY_KEY_SECRET,
  //   RAZORPAY_WEBHOOK_SECRET, RESEND_API_KEY,
  //   SHIPROCKET_PASSWORD (Shiprocket API user), SHIPROCKET_WEBHOOK_TOKEN
  // See docs/PAYMENTS_SETUP.md.
  "vars": {
    "SUPABASE_URL": "https://acnhzuiisexsiuondawt.supabase.co",
    "SITE_URL": "https://trishuldivine.com",
    // Must be an address on a domain you have verified in Resend.
    "EMAIL_FROM": "Trishul Divine <orders@trishuldivine.com>",
    "SUPPORT_EMAIL": "trishuldivine26@gmail.com",
    // Comma-separated. These addresses get an email for every new paid order.
    "ADMIN_NOTIFY_EMAIL": "trishuldivine26@gmail.com",
    // Shiprocket pickup address: the nickname saved in Shiprocket → Settings → Pickup Addresses,
    // and its pincode (used to price couriers at checkout).
    "SHIPROCKET_PICKUP_LOCATION": "Home",
    // Shiprocket API user's login email (Settings → API Users); its password is a secret.
    "SHIPROCKET_EMAIL": "trishuldivine26+api@gmail.com",
    "SHIPROCKET_PICKUP_PINCODE": "521185",
    // "true": after payment, book the cheapest courier (charged to the Shiprocket wallet)
    // and schedule pickup automatically. "false": ship each order by hand in Shiprocket.
    "SHIPROCKET_AUTO_SHIP": "true"
  }
}
